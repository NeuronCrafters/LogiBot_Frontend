# Para dev local, copie para .env e preencha.
# Em produção, configure no painel do Cloudflare Pages (Settings > Environment variables).

# URL base da API — produção: https://api.saellogibot.com
VITE_API_BASE_URL=https://api.saellogibot.com

# Chave de API (mesmo valor que API_KEY no backend)
VITE_API_KEY=
