# =============================================================================
# LogiBot Frontend — variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores antes de rodar localmente.
#
# ATENÇÃO — Deploy na Cloudflare Pages:
#   Configure essas variáveis no painel do Cloudflare Pages em:
#     Settings > Environment variables
#   As variáveis prefixadas com VITE_ são embutidas no bundle durante o build,
#   portanto NÃO coloque valores secretos nelas.
# =============================================================================


# -----------------------------------------------------------------------------
# API Backend
# -----------------------------------------------------------------------------

# URL base da API do backend.
# Produção:    https://api.saellogibot.com
# Desenvolvimento local: http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Chave de API enviada no header "x-api-key" em todas as requisições.
# Deve ser o mesmo valor configurado em API_KEY no backend.
VITE_API_KEY=
